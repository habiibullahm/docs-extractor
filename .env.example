# Copy to .env (never commit it). Needed only for approaches B and C.
# Gemini API key from Google AI Studio, in a project with billing NOT enabled (free tier, $0).
GEMINI_API_KEY=
# B/C call a hosted model API. Leave false unless the key is free tier without billing,
# or a spend limit is set with the provider.
DOCEX_ENABLE_LLM=false
# OPENAI_API_KEY=      # only if configs/pipeline.yaml uses provider: openai (paid)
# ANTHROPIC_API_KEY=   # only if configs/pipeline.yaml uses provider: anthropic
# Default approach for the API when none is given (A works without any key)
# DOCEX_APPROACH=C
# Override the model, e.g. another free-tier Gemini model
# DOCEX_VLM__MODEL=gemini-flash-lite-latest
